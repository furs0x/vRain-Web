# Keep scripts and sources as LF so Git Bash on Windows can run them.
*.sh text eol=lf
*.pl text eol=lf
*.pm text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.md text eol=lf
*.MD text eol=lf
*.txt text eol=lf
*.cfg text eol=lf
*.command text eol=lf
*.bat text eol=crlf
*.jpg binary
*.png binary
*.pdf binary
*.ttf binary
*.otf binary
*.ttc binary
